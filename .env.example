# Environment variables used by the project. Copy this file to `.env`, fill in the values you need and load it in
# your shell before running a command:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# `.env` is ignored by git. Never commit real secrets. On Vercel and GitHub Actions the same names are set in the
# service's settings, not in a file.

# --- Council server (council/service) and judges' site (site/, Vercel) -----------------------------------------------
# Shared secret between the council server and the site's functions. Generate one with: openssl rand -hex 32
COUNCIL_SECRET=
# Public HTTPS address of the council server, started with `python -m reviewer --live ...` (site/ only)
COUNCIL_URL=
# Port of the local site server (site/local.mjs); default 3000
# PORT=3000

# --- Demo set (council/data, council/review, council/trial.sh) ------------------------------------------------------
# Folder of the private demo set; default council/data/demo-set
# COUNCIL_DEMO_SET=
# Git URL of the private demo set repository, cloned by council/trial.sh
# DEMO_SET_REPO=

# --- MI300X on AMD Developer Cloud (site/mi300x/mi300x.sh, .github/workflows/mi300x.yml) ----------------------------
# API token of the team on AMD Developer Cloud / DigitalOcean
DIGITALOCEAN_ACCESS_TOKEN=
# Fingerprint of the SSH key installed on new machines
MI300X_SSH=
# API base URL; use https://api.devcloud.amd.com if the default does not accept the AMD token
# DO_API=https://api.digitalocean.com
# Optional DNS record pointed at a new machine's IP, if the domain is managed on DigitalOcean
# MI300X_DNS_DOMAIN=
# MI300X_DNS_NAME=
# Optional tuning, see site/mi300x/README.md
# MI300X_TAG=council-mi300x
# MI300X_HEALTH=
# MI300X_CLOUD_INIT=
# MI300X_POLL=
# MI300X_LEAD=
# MI300X_RETRIES=

# --- Runs on the MI300X (council/trial.sh, council/mi300x.sh) -------------------------------------------------------
# MODEL=Qwen/Qwen3-14B
# STEPS=
# LIMIT=
# NO_REALIGN=1
# SYSTEM_TORCH=1
# TORCH_INDEX_URL=

# --- Tests with a model (engine/, g1/) ------------------------------------------------------------------------------
# ENGINE_MODEL=Qwen/Qwen3-0.6B
# ENGINE_REVISION=
# G1_MODEL=
# G1_REVISION=
