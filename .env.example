# The secrets the project needs. None is stored in the repository: set them in the environment of the service that
# runs the code (Vercel, GitHub Actions, the shell on the MI300X). Other options have defaults: see each README.

# Council server (council/service) and judges' site functions (site/, Vercel): the same shared secret on both.
# Generate one with: openssl rand -hex 32
COUNCIL_SECRET=
# Judges' site on Vercel: public HTTPS address of the council server.
COUNCIL_URL=

# MI300X scheduling (.github/workflows/mi300x.yml, as GitHub Actions secrets): AMD Developer Cloud API token and the
# fingerprint of the SSH key installed on new machines.
DIGITALOCEAN_ACCESS_TOKEN=
MI300X_SSH=
